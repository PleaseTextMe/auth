  "liveNow": false,
  "panels": [
    {
      "title": "HTTP Requests Rate (RPS)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total[1m])) by (handler, status)",
          "legendFormat": "{{handler}} [{{status}}]"
        }
      ]
    },
    {
      "title": "Active WebSocket Connections",
      "type": "stat",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "active_websocket_connections",
          "legendFormat": "Active WS Connections"
        }
      ]
    },
    {
      "title": "Auth Login Attempts",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "sum(rate(auth_login_attempts_total[5m])) by (status)",
          "legendFormat": "Logins [{{status}}]"
        }
      ]
    },
    {
      "title": "User Registrations",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "sum(rate(auth_registrations_total[5m])) by (status)",
          "legendFormat": "Registrations [{{status}}]"
        }
      ]
    },
    {
      "title": "Typing Events",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "sum(rate(typing_events_total[5m]))",
          "legendFormat": "Typing Events Rate"
        }
      ]
    },
    {
      "title": "Email Verification Codes Sent",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [
        {
          "expr": "sum(rate(auth_verification_codes_generated_total[5m]))",
          "legendFormat": "Verification Codes Sent"
        }
      ]
    }
  ],
  "refresh": "5s",
